{
  // --- 🧭 UI / WORKBENCH ---
  "window.commandCenter": true,
  "window.restoreWindows": "none",
  "workbench.list.openMode": "doubleClick",
  "workbench.colorTheme": "Visual Studio Light",
  "workbench.startupEditor": "none",
  // --- 📁 FILES / EXPLORER ---
  "files.autoSave": "afterDelay",
  "files.associations": {
    "*.Rmd": "rmd",
    "*.R": "r"
  },
  "files.eol": "\n",
  "files.hotExit": "onExitAndWindowClose",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.watcherExclude": {
    "**.Rproj": true,
    "**/.cache/**": true,
    "**/.Rproj.user/**": true,
    "**/renv/**": true,
    "**/env/**": true
  },
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "search.exclude": {
    "**/renv": true
  },
  // --- 📂 PATH INTELLISENSE ---
  "path-intellisense.autoTriggerAfterSlash": true,
  "path-intellisense.showHiddenFiles": true,
  // --- 🧠 EDITOR CORE ---
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.tabSize": 2,
  "editor.rulers": [
    80,
    {
      "color": "#b22222",
      "column": 120
    }
  ],
  // --- 🗺 DOCUMENT NAVIGATION (Quarto / Markdown / Rmd) ---
  // Sticky scroll: pins the current heading at the top of the editor while scrolling
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  // Breadcrumbs: heading hierarchy bar at the top of each file
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "last",
  "breadcrumbs.symbolPath": "on",
  // Outline panel: always show up to H4 depth, keep symbols sorted by position
  "outline.showMarkdownHeaderDepth": true,
  "outline.collapseItems": "alwaysExpand",
  // --- 🐍 PYTHON / UV ---
  "python.defaultInterpreterPath": "/usr/bin/python",
  "python.createEnvironment.trigger": "off",
  "python.terminal.activateEnvironment": false,
  "python.analysis.supportRestructuredText": true,
  // uv integration (use uvx manually in terminal/tasks)
  "python.envFile": "${workspaceFolder}/.env",
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "ruff.lineLength": 72,
  // --- 📊 R / QUARTO ---
  "r.bracketedPaste": true,
  "r.plot.useHttpgd": true,
  "r.plot.defaults.fullWindowMode": true,
  "r.removeLeadingComments": true,
  "r.session.levelOfObjectDetail": "Normal",
  // radian: enhanced R terminal (syntax highlighting, multiline editing, history)
  "r.rterm.linux": "/home/bastien/.local/bin/radian",
  "r.rterm.option": [
    "--no-save",
    "--no-restore",
    "--quiet"
  ],
  "r.helpPanel.enableHoverLinks": true,
  // Air (Posit) — official R formatter; format on save for .R / .Rmd
  // https://posit-dev.github.io/air/editor-vscode.html
  "r.formatting.provider": "none",
  "[r]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Posit.air-vscode",
    "editor.wordSeparators": "`~!@#%$^&*()-=+[{]}\\|;:'\",<>/?"
  },
  "[rmd]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Posit.air-vscode"
  },
  "[quarto]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "quarto.quarto"
  },
  "quarto.visualEditor.spellingDictionary": "en_GB",
  // Assist Panel: real-time equation + figure thumbnail in the sidebar
  // Open with: Ctrl+Shift+P → "Quarto: Show Assist Panel"
  // Live preview (equations / Mermaid): Ctrl+Shift+L above any math block
  // Full document preview (HTML side pane): Ctrl+Shift+K
  "quarto.render.previewType": "internal",
  // --- 🔧 DOCKER / YAML ---
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "docker.extension.enableComposeLanguageServer": false,
  // --- ✏️ SPELL CHECK / GRAMMAR (LTeX+ & cSpell) ---
  // Default LanguageTool / LTeX language = British English
  "ltex.language": "en-GB",
  "ltex.additionalLanguages": {
    "fr": "fr-FR"
  },
  // Quick-fix "Add to dictionary" → user (global), not .vscode/ in the project
  "ltex.configurationTarget": {
    "dictionary": "userExternalFile",
    "disabledRules": "user",
    "enabledRules": "user",
    "hiddenFalsePositives": "user"
  },
  // Global en-GB word list (append target for userExternalFile)
  "ltex.dictionary": {
    "en-GB": [
      ":/home/bastien/ltex/ltex.dictionary.en-GB.txt"
    ],
    "fr-FR": [
      ":/home/bastien/ltex/ltex.dictionary.fr-FR.txt"
    ]
  },
  // Markup: full-document check. Programming languages: comments only
  // (LTeX parses code modes and ignores raw identifiers/statements).
  // Do not spell-check config languages (yaml/toml/json) or shell scripts.
  "ltex.enabled": [
    "markdown",
    "quarto",
    "latex",
    "bibtex",
    "rmd",
    "restructuredtext",
    "plaintext",
    "python",
    "r",
    "julia",
    "javascript",
    "typescript",
    "cpp",
    "c",
    "java",
    "rust",
    "go"
  ],
  "cSpell.language": "en-GB,fr",
  "cSpell.enabledFileTypes": {
    "*": true,
    "markdown": true,
    "quarto": true,
    "latex": true,
    "bibtex": true,
    "plaintext": true,
    "python": true,
    "r": true,
    "julia": true,
    "javascript": true,
    "typescript": true,
    "cpp": true,
    "c": true,
    "java": true,
    "rust": true,
    "go": true,
    "jupyter": true,
    "rmd": true,
    "restructuredtext": true,
    "yaml": false,
    "yml": false,
    "toml": false,
    "json": false,
    "jsonc": false,
    "ini": false,
    "properties": false,
    "shellscript": false,
    "dockerfile": false
  },
  // Skip dotfiles/dotfolders and machine-/tool-config paths entirely.
  "cSpell.ignorePaths": [
    "**/.*/**",
    "**/.*",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/*.json",
    "**/*.jsonc",
    "**/*.lock",
    "**/*.Rproj",
    "**/renv/**",
    "**/output/**",
    "**/docs/**",
    "**/article/**",
    "**/data/**",
    "**/pkgdown/**",
    "**/NAMESPACE",
    "**/DESCRIPTION"
  ],
  // In source code, only spell-check comments — never raw identifiers/code.
  "cSpell.languageSettings": [
    {
      "languageId": "python,r,julia,javascript,typescript,javascriptreact,typescriptreact,cpp,c,java,rust,go",
      "includeRegExpList": [
        "Comments"
      ]
    }
  ],
  // --- 🔀 GIT / GITLENS ---
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.pruneOnFetch": true,
  "githubIssues.issueBranchTitle": "fix/issue${issueNumber}",
  "githubIssues.workingIssueFormatScm": "fix: ${issueTitle}\n\nFixes ${issueNumberLabel}",
  "githubPullRequests.fileListLayout": "tree",
  "githubPullRequests.pullBranch": "never",
  "gitlens.launchpad.indicator.enabled": false,
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
  // --- 🔍 MARKDOWNLINT ---
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,qmd,rmd}",
    "!**/node_modules",
    "!**/vendor",
    "!**/.git"
  ],
  // --- 📝 BETTER COMMENTS ---
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#FF2D00"
    },
    {
      "tag": "?",
      "color": "#3498DB"
    },
    {
      "tag": "//",
      "color": "#474747",
      "strikethrough": true
    },
    {
      "tag": "todo",
      "color": "#FF8C00"
    },
    {
      "tag": "*",
      "color": "#98C379"
    }
  ],
  // --- 🔒 TELEMETRY ---
  "redhat.telemetry.enabled": false,
  "git.ignoreRebaseWarning": true,
  "remote.SSH.remotePlatform": {
    "new-mmg-cluster": "linux",
    "old-mmg-cluster": "linux"
  },
  "remote.autoForwardPortsSource": "hybrid",
  "yaml.schemas": {
    "file:///home/bastien/.cursor/extensions/continue.continue-1.2.22-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ],
    "file:///home/bastien/.cursor/extensions/continue.continue-2.0.0-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },
  "window.autoDetectColorScheme": false,
  "window.confirmSaveUntitledWorkspace": false,
  "git.enableSmartCommit": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "cSpell.enabledSchemes": {
    "comment": true,
    "file": true,
    "gist": true,
    "repo": true,
    "sftp": true,
    "untitled": true,
    "vscode-notebook-cell": true,
    "vscode-scm": true,
    "vscode-userdata": true,
    "vscode-vfs": true,
    "vsls": true,
    "overleaf-workshop": true
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "workbench.iconTheme": "vscode-icons",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "diffEditor.ignoreTrimWhitespace": false
}
