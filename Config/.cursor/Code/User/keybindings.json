[
  // --- Global Search (clean override) ---
  {
    "key": "ctrl+shift+f",
    "command": "-workbench.view.search"
  },
  {
    "key": "ctrl+shift+f",
    "command": "-workbench.action.findInFiles"
  },
  {
    "key": "ctrl+shift+f",
    "command": "-workbench.action.terminal.searchWorkspace"
  },
  {
    "key": "ctrl+shift+f",
    "command": "workbench.action.findInFiles"
  },
  // --- R / Rmd Editing Helpers ---
  {
    "key": "ctrl+shift+w",
    "command": "type",
    "when": "editorTextFocus && editorLangId =~ /r|rmd|qmd/",
    "args": {
      "text": " <- "
    }
  },
  // --- native pipe ---
  {
    "key": "ctrl+shift+m",
    "command": "type",
    "when": "editorTextFocus && editorLangId =~ /r|rmd/",
    "args": {
      "text": " |> "
    }
  },
  {
    "key": "ctrl+shift+m",
    "command": "-workbench.actions.view.problems"
  },
  // --- R Markdown Snippets ---
  {
    "key": "ctrl+alt+i",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus && editorLangId == 'rmd'",
    "args": {
      "snippet": "```{r}\n${TM_SELECTED_TEXT}$0\n```"
    }
  },
  // --- R Help / Navigation ---
  {
    "key": "f1",
    "command": "r.helpPanel.openForSelection",
    "when": "editorTextFocus && editorLangId =~ /r|rmd/"
  },
  {
    "key": "ctrl+shift+r",
    "command": "editor.action.insertSnippet",
    "args": {
      "snippet": "# ${1:Section Name} ----\n"
    },
    "when": "editorTextFocus && (resourceExtname == .R || resourceExtname == .Rmd || resourceExtname == .qmd)"
  },
  {
    "key": "ctrl+.",
    "command": "workbench.action.showAllSymbols",
    "when": "editorLangId == 'r'"
  },
  {
    "key": "ctrl+.",
    "command": "-editor.action.quickFix",
    "when": "editorLangId == 'r' && editorHasCodeActionsProvider && textInputFocus && !editorReadonly"
  },
  // --- R Package Development (devtools; non-overlapping with tasks below) ---
  {
    "key": "ctrl+shift+b",
    "command": "r.runCommand",
    "when": "editorTextFocus && editorLangId =~ /r|rmd/",
    "args": "devtools::build()"
  },
  {
    "key": "ctrl+shift+l",
    "command": "r.runCommand",
    "when": "editorTextFocus && editorLangId =~ /r|rmd/",
    "args": "devtools::load_all()"
  },
  // --- R package tasks (server chords; document / test / check) ---
  {
    "key": "ctrl+shift+alt+d",
    "command": "workbench.action.tasks.runTask",
    "args": "R: document"
  },
  {
    "key": "ctrl+shift+alt+t",
    "command": "workbench.action.tasks.runTask",
    "args": "R: test"
  },
  {
    "key": "ctrl+shift+alt+c",
    "command": "workbench.action.tasks.runTask",
    "args": "R: check"
  },
  // --- R quick plot viewer ---
  {
    "key": "ctrl+alt+p",
    "command": "r.runCommand",
    "when": "editorTextFocus && editorLangId == 'r'",
    "args": ".vsc.browser(httpgd::hgd_url(), viewer = \"Beside\")"
  },
  // --- Roxygen Template ---
  {
    "key": "ctrl+alt+shift+r",
    "command": "type",
    "when": "editorTextFocus && editorLangId =~ /r|rmd/",
    "args": {
      "text": "\n#' Title\n#'\n#' Description\n#'\n#' @param\n#'\n#' @export\n#'\n#' @example\n"
    }
  },
  // --- Marimo ---
  {
    "key": "ctrl+alt+m",
    "command": "marimo.openNotebook",
    "when": "resourceExtname == '.py'"
  },
  {
    "key": "ctrl+alt+shift+m",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "uvx marimo edit --sandbox \n"
    }
  },
  {
    "key": "ctrl+alt+r",
    "command": "workbench.action.terminal.sendSequence",
    "when": "resourceExtname == '.py'",
    "args": {
      "text": "uvx marimo run '${file}'\n"
    }
  },
  // --- LaTeX Workshop SyncTeX (source → PDF) ---
  {
    "key": "ctrl+j",
    "command": "latex-workshop.synctex",
    "when": "editorTextFocus && (editorLangId == 'latex' || editorLangId == 'tex' || resourceExtname == '.tex')"
  },
  {
    "key": "ctrl+alt+j",
    "command": "-latex-workshop.synctex"
  }
]
